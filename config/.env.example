# ==============================================================================
# Agentic Trading Setup - Environment Configuration
# ==============================================================================

# 1. Zerodha Kite Connect Configuration
# Generated via https://developers.kite.trade/
KITE_API_KEY=your_zerodha_kite_api_key_here
KITE_API_SECRET=your_zerodha_kite_api_secret_here
KITE_USER_ID=your_kite_client_id
# Optional: TOTP secret for automated daily access token generation
KITE_TOTP_SECRET=your_kite_totp_secret_key
# Alternatively, set manually each morning:
KITE_ACCESS_TOKEN=your_daily_kite_access_token

# 2. Groww Configuration
# Session cookie / API token for Groww
GROWW_USER_ID=your_groww_user_id
GROWW_SESSION_TOKEN=your_groww_web_session_token

# 3. INDmoney Configuration
# Session token for INDmoney portfolio tracking
INDMONEY_USER_ID=your_indmoney_user_id
INDMONEY_AUTH_TOKEN=your_indmoney_jwt_or_bearer_token
INDMONEY_DEVICE_ID=your_indmoney_device_id

# 4. News & Notification Webhooks
# Telegram Bot for urgent adverse alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Discord Webhook for market updates and morning briefings
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 5. MCP Settings
MCP_INDIAN_MARKET_HOST=localhost
MCP_INDIAN_MARKET_PORT=8000
